  19          void Uart_Send_Byte(unsigned char c)//UART Send a byte
  20          {
  21   1              SBUF = c;
  22   1              while(!TI);             //发送完为1 
  23   1              TI = 0;
  24   1      }
  25          /********************************************************************
  26          * 名称 : UART_Init()
  27          * 功能 : 单片机串口初始化
  28          * 单片机：晶振11.0592MHz 波特率为9600bps
  29          * 舵机模块：波特率为9600bps，
  30          ********************************************************************/        
  31          void UART_Init()
  32          {
  33   1              SCON= 0x50;               //串口方式1   //REN=1; 允许接收
  34   1              PCON=0x00;                //SMOD=0
  35   1              TMOD= 0x22;               //定时器1定时方式2
  36   1              TH1= 0xFD;                //11.0592MHz  模块默认波特率为9600bps
  37   1              TL1= 0xFD;                                                                               
  38   1              TR1= 1;                   //启动定时器 
  39   1              EA=1;   
  40   1      }
  41          /*---------------------------------------------------------------
  42                  adder：模块的硬件地址
  43                  num：通道 0-15
  44                  off为0-180,off大于等于200时不输出信号，此时释放舵机
  45          ----------------------------------------------------------------*/
  46          void setPWM(uchar adder,uchar num,uchar off) 
  47          {
  48   1              Uart_Send_Byte(0XFA);
  49   1              Uart_Send_Byte(adder);
  50   1              Uart_Send_Byte(num);
  51   1              Uart_Send_Byte(off);
  52   1              Uart_Send_Byte(0XFE);
  53   1      }
